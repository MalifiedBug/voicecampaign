# ==============================================================================
# Voice Campaign — Environment Variables Configuration
# ==============================================================================
# Use this file to configure Vobiz telephony credentials and server policies.
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production (Vercel):
#   Add these key-value pairs in your Vercel Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VOBIZ API CREDENTIALS (Required)
# ------------------------------------------------------------------------------
# Retrieve these credentials from your Vobiz Console (https://console.vobiz.ai)
VOBIZ_AUTH_ID=MA_XXXXXXXXXXXXXXXXXX
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token_here

# ------------------------------------------------------------------------------
# 2. CALLER ID & TELEPHONY ROUTING (Required for dialing)
# ------------------------------------------------------------------------------
# The verified Vobiz phone number or purchased DID in E.164 format (e.g. +91...)
VOBIZ_CALLER_ID=+919876543210

# ------------------------------------------------------------------------------
# 3. WEBHOOK PUBLIC BASE URL (Recommended)
# ------------------------------------------------------------------------------
# The public HTTPS URL where Vobiz sends webhook callbacks (/webhook/answer & /webhook/hangup)
# - In Vercel: Automatically detected from VERCEL_URL if omitted, but setting
#   your canonical domain (e.g. https://farmcalling.vercel.app) is recommended.
# - In Local Development: Set to your ngrok or tunnel URL (e.g. https://xxxx.ngrok-free.app)
WEBHOOK_BASE_URL=https://your-app.vercel.app

# ------------------------------------------------------------------------------
# 4. OPTIONAL TELEPHONY & TIMEOUT POLICIES
# ------------------------------------------------------------------------------
# Default application name registered on Vobiz network
VOBIZ_APP_NAME=Voice-Campaign-App

# Pre-registered Vobiz Application ID (if you already created one via Vobiz console)
VOBIZ_APP_ID=

# Ring timeout in seconds before abandoning unanswered calls (10 to 120 seconds)
VOBIZ_RING_TIMEOUT=30

# Maximum call duration in seconds (e.g. 3600 for 1 hour)
VOBIZ_TIME_LIMIT=3600

# Answering Machine Detection: "false" (disabled), "true" (detect), or "hangup" (cut on voicemail)
VOBIZ_MACHINE_DETECTION=false

# ------------------------------------------------------------------------------
# 5. PERSISTENT STORAGE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for Supabase PostgreSQL database (retains persistence across Vercel serverless cold boots)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"


# Application timezone (e.g. Asia/Kolkata, UTC, America/New_York)
VOBIZ_TIMEZONE=Asia/Kolkata

# Default Text-to-Speech Voice ("WOMAN" or "MAN")
VOBIZ_TTS_VOICE=WOMAN

# Default Text-to-Speech Language ("en-US", "en-IN", "hi-IN", "en-GB")
VOBIZ_TTS_LANGUAGE=en-US

